# Agent Platform 配置模板（本地开发默认）
# 用法：复制为 .env 或由部署层注入环境变量；部署前按实际环境填写。
# 约定：[必填] = 无默认值、必须提供；未标注 = 可用默认值。
# 详细字段说明（默认值/单位/必填）见 charts/agent-platform/CONFIGURATION.md。

# 运行环境：development / uat / production。
APP_ENV=development
# 是否允许开发期免鉴权访问；生产必须为 false。
ALLOW_INSECURE_AUTH=true
# 服务间调用令牌：非 development 环境[必填]，禁止提交真实值。
SERVICE_TOKEN=
# 业务 HTTP 监听地址（默认 :8080）。
HTTP_ADDR=:8080

# PostgreSQL 连接串：[必填] 格式 postgres://用户:密码@主机:端口/库?sslmode=disable。
DATABASE_DSN=postgres://agent:agent@localhost:5432/agent_platform?sslmode=disable
# Redis 地址（默认 redis://127.0.0.1:6379/0）。
REDIS_URL=redis://127.0.0.1:6379/0

# 对象存储（S3 兼容）。S3_ENDPOINT/S3_BUCKET/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY 必填。
S3_ENDPOINT=localhost:9000
S3_PUBLIC_ENDPOINT=localhost:9000
# 供沙箱 Pod 访问的对象存储地址（Docker Desktop K8s 本地场景示例）。
S3_SANDBOX_ENDPOINT=10.1.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=agent-platform
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false
# 预签名下载 URL 有效期（默认 15m；单位 m/h）。
S3_PRESIGN_TTL=15m

# 运行沙箱所在 K8s 命名空间（默认 default）。
K8S_NAMESPACE=default
# 预热沙箱池名称（默认 agent-sandbox-pool）。
SANDBOX_WARM_POOL=agent-sandbox-pool

# 模型网关：本服务为旁路小应用，不在此处配置模型；
# 主程序按 Run 逐次传入 model.upstream_base_url（及可选 upstream_api_key）。
# 沙箱只经由控制面模型网关、使用运行级令牌访问。
MODEL_GATEWAY_BASE_URL=http://control-plane:8080/internal/model/v1
# 模型令牌有效期（默认 35m）。
MODEL_TOKEN_TTL=35m
# 单次运行执行超时（默认 30m）。
SANDBOX_EXECUTION_TIMEOUT=30m
# 允许的模型上游地址白名单（逗号分隔；平台级凭据绝不送入沙箱）。
MODEL_ALLOWED_UPSTREAM=https://opencode.ai/zen/go/v1
# 平台持有的上游模型凭据（可选，按上游要求填写，绝不送入沙箱）。
MODEL_UPSTREAM_API_KEY=

# 工作协程：轮询间隔与并发数。
WORKER_POLL_INTERVAL=1s
WORKER_CONCURRENCY=4
