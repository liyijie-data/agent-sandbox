# agent-demo 后端配置模板（示例）
# 用法：复制为 .env 或 .env-uat 并按环境填写；真实 .env/.env-uat 不入版本库。
# 约定：[必填] = 无默认值、必须填写；未标注 = 可使用默认值。

# 平台（控制面）访问入口：agent-demo 调用的 Agent Platform API。
AGENT_PLATFORM_BASE_URL=http://127.0.0.1:30080
# 平台下发的客户端 API Key：[必填]
AGENT_PLATFORM_CLIENT_API_KEY=
# 使用的运行时镜像 ID（由平台注册的镜像决定）。
AGENT_PLATFORM_IMAGE_ID=agent-platform-runtime-v1

# 模型参数：经由平台/直连上游模型时的供应商与模型名。
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5
# 模型上游地址；直连时填写，经平台转发时留空或按平台要求。
MODEL_UPSTREAM_BASE_URL=https://model-gateway.example/v1
# 模型上游 API Key（[必填]若直连）。
MODEL_UPSTREAM_API_KEY=

# 沙箱网络访问经独立 network API 配置，与上文模型地址相互独立。

# MySQL 连接串：[必填] 格式 mysql://用户:密码@主机:端口/库。
MYSQL_DSN=mysql://<user>:<password>@<host>:3306/agent_demo
# Redis 地址：[必填] 格式 redis://用户:密码@主机:端口/库。
REDIS_URL=redis://<user>:<password>@<host>:6379/1
# Redis 键前缀。
REDIS_KEY_PREFIX=agent-demo:

# 对象存储（S3 兼容，保存会话附件等）。S3_ENDPOINT/S3_BUCKET/密钥必填。
S3_ENDPOINT=<host>:9000
# 浏览器可见的预签名地址主机；留空则使用 S3_ENDPOINT。
S3_PUBLIC_ENDPOINT=
# 沙箱 Pod 可达的对象存储地址；默认回退 S3_PUBLIC_ENDPOINT。
S3_SANDBOX_ENDPOINT=
S3_BUCKET=agent-demo
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=false

# 会话有效期与预签名有效期（秒）。
SESSION_TTL_SECONDS=86400
PRESIGN_TTL_SECONDS=900
# 运行令牌有效期（秒）。
RUNTIME_TOKEN_TTL_SECONDS=7200
# 单次上传大小上限（字节），默认 104857600（100 MiB）。
MAX_UPLOAD_BYTES=104857600
